# Allow peer-dep resolution to proceed when transitive peers don't yet support
# ESLint 10. As of 2026-05, eslint-plugin-react@7.37.5 declares peer eslint
# "<=9.7" but works fine at runtime with eslint@10. Without this flag, `npm ci`
# fails on CI runners that don't pass --legacy-peer-deps explicitly.
#
# Remove this when:
#   - eslint-plugin-react ships a release with peer eslint >=10, OR
#   - the project downgrades eslint to <10.
#
# See PR #736 for the CI failure that surfaced this.
legacy-peer-deps=true
