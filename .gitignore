# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# contentlayer
/.contentlayer

# editor
.vscode/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# optimized images (can be regenerated)
/public/images/trees/optimized/

/src/generated/prisma

# Claude Code worktrees (managed by the harness, not version-controlled).
# Note: .claude/skills/, .claude/agents/, .claude/settings.json, and the
# root-level CLAUDE.md / scoped CLAUDE.md files ARE committed — they are
# the agent boot configuration.
.claude/worktrees/

# Agent session state (local, not for sharing)
.claude/sessions/
.claude/logs/

# Generated audit/report artifacts.
#
# These were tracked: lighthouse-report.json (920 KB) and
# lighthouse-report-mobile.json (891 KB) were manual drops last touched
# 2026-03-01; audit-report.md (107 KB) is written by
# .github/workflows/weekly-image-quality.yml and was committed by
# create-pull-request sweeping the working tree; audit-content-report.md
# reported 133 trees when the corpus had 180. ~1.9 MB of stale output that read
# as current.
#
# reports/ stays TRACKED on purpose — scripts/CLAUDE.md rule 3 relies on state
# files there for idempotent checkpointing.
/lighthouse-report.json
/lighthouse-report-mobile.json
/audit-report.md
/audit-content-report.md
