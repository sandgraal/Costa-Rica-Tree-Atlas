# =============================================================================
# SECURITY WARNING: DO NOT COMMIT ACTUAL VALUES TO GIT
# Copy this file to .env.local and fill in your actual secrets
# =============================================================================

# =============================================================================
# Authentication (REQUIRED for production)
# =============================================================================

# Break-glass credentials for when the database is unreachable.
#
# DISABLED IN PRODUCTION by src/app/api/auth/[...nextauth]/route.ts — this path
# bypasses MFA and the user table entirely, so it must never be a second front
# door to a live admin surface. Recovering a locked-out production admin is a
# database operation, not a login flow.
#
# (These replace ADMIN_DEV_BYPASS, which was documented here for a long time and
# was read by no code anywhere in the repo — security theatre for a mechanism
# that did not exist.)
# ADMIN_FALLBACK_EMAIL=admin@example.com
# ADMIN_FALLBACK_PASSWORD=

# Required to POST /api/admin/setup, which creates the first admin user.
# The "no users exist yet" check is not an authorization control: point the app
# at a fresh or restored database and the admin account becomes claimable by
# whoever reaches the endpoint first.
# Generate with: openssl rand -hex 32
# SETUP_TOKEN=

# Supabase Postgres.
#
# DATABASE_URL  -> transaction-mode pooler (Supavisor), port 6543. This is what
#                  the app runs against; serverless functions cannot hold direct
#                  Postgres connections.
# DIRECT_URL    -> direct/session connection, port 5432. Used ONLY by
#                  `prisma migrate`, which needs advisory locks and DDL that a
#                  transaction pooler cannot carry.
#
# Both are in the Supabase dashboard under Project Settings -> Database ->
# Connection string. Use the "Transaction" tab for DATABASE_URL and the
# "Session" tab for DIRECT_URL.
#
# Append `?pgbouncer=true&connection_limit=1` to DATABASE_URL.
# See docs/DATABASE.md.
DATABASE_URL=
DIRECT_URL=

# NextAuth secret for JWT signing (256-bit minimum)
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# NextAuth URL (your site URL)
NEXTAUTH_URL=http://localhost:3000

# MFA encryption key for TOTP secrets (64-character hex string = 32 bytes)
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# (ADMIN_TOTP_SECRET_SALT was documented here and read by no code. MFA uses
# MFA_ENCRYPTION_KEY above — see src/lib/auth/mfa-crypto.ts.)

# =============================================================================
# Rate Limiting (REQUIRED for production)
# =============================================================================

# Upstash Redis for persistent rate limiting
# Sign up for free at https://upstash.com (10,000 commands/day free tier)
# Without these, rate limiting uses in-memory storage (resets on deployment)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Number of trusted proxy hops (optional, default: 2)
# - Behind Cloudflare + Vercel: 2 (default)
# - Behind Cloudflare only: 1
# - Behind custom CDN + Cloudflare + Vercel: 3
# - Direct to Vercel (no CDN): 1
# TRUSTED_PROXY_COUNT=2

# =============================================================================
# Private API v1 Access Control
# =============================================================================

# Shared API key for approved API v1 consumers (server-side only)
API_V1_KEY=

# Optional comma-separated allowlisted IPv4/IPv6 addresses for API v1 access
# Example: API_V1_ALLOWLIST=203.0.113.12,2001:db8::1
API_V1_ALLOWLIST=

# =============================================================================
# Optional Features
# =============================================================================

# IUCN Red List API v4 (optional but strongly recommended)
# Apply for a token at https://api.iucnredlist.org (free, non-commercial use)
# Powers the iucn-verifier subagent and live conservation-status CI checks.
# Without this, the IUCN MCP server is disabled and audits fall back to GBIF's
# cached (potentially stale) IUCN data.
IUCN_TOKEN=

# Pl@ntNet plant identification API (optional)
# Apply for a free key at https://my.plantnet.org → My Apps
# Enables the /api/identify camera-first ID feature (FEATURE_ENABLED auto-activates
# when this key is present — no code change needed).
# Free tier: 500 requests/day. See https://plantnet.org/en/api/ for limits.
PLANTNET_API_KEY=

# Google Maps (optional) — client-side, so it MUST use the NEXT_PUBLIC_ prefix.
# Read by src/components/maps/GoogleMapsProvider.tsx. Without it, map views
# render an explicit "map service is not configured" state rather than hanging.
# Restrict the key by HTTP referrer in the Google Cloud console.
# (The server-side GOOGLE_MAPS_API_KEY documented here previously is read by no
# code; Google Vision was replaced by Pl@ntNet.)
# NEXT_PUBLIC_MAPS_API_KEY=

# CSP Violation Reporting (optional)
# CSP_REPORT_URI=https://your-logging-service.com/csp-report

# =============================================================================
# Public Variables (exposed to browser)
# =============================================================================

# Site URL for canonical links and SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics domain (optional)
# NEXT_PUBLIC_ANALYTICS_DOMAIN=costaricatreeatlas.com

# Analytics providers (all optional, all privacy-respecting, all read by
# src/components/Analytics.tsx). None were documented here before.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=costaricatreeatlas.org
# NEXT_PUBLIC_ENABLE_SIMPLE_ANALYTICS=true
# NEXT_PUBLIC_GA_ID=

# =============================================================================
# Media & Uploads (required for the community photo-upload feature)
# =============================================================================

# Cloudinary — stores user-submitted photos. Uploads are EXIF-stripped before
# they leave the server (see tests/security/exif-strip.test.ts); this matters
# because a phone can embed precise GPS on a protected species.
# Without these, /api/images/upload returns 503 "storage not configured".
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# =============================================================================
# Network & CORS
# =============================================================================

# Comma-separated origins allowed to POST to the API (CSRF origin check).
# ALLOWED_ORIGINS=https://costaricatreeatlas.org
# DEV_ALLOWED_ORIGINS=http://localhost:3000

# How many trusted proxies sit in front of the app, for client-IP resolution
# in rate limiting. Default 2 (Cloudflare + Vercel).
# TRUSTED_PROXY_COUNT=2

# Minimum duration in ms for auth rate-limit checks, so the check's own outcome
# is not observable through response timing. Default 50.
# RATE_LIMIT_MIN_DURATION_MS=50

# =============================================================================
# Image proposal workflow (used by .github/workflows/weekly-image-quality.yml)
# =============================================================================

# Shared secret authenticating workflow POSTs to /api/admin/images/proposals.
# Without it, workflow authentication is disabled outright — the endpoint used
# to accept any header starting "Bearer workflow-".
# Generate with: openssl rand -hex 32
# IMAGE_PROPOSALS_WORKFLOW_TOKEN=
# IMAGE_PROPOSALS_API_BASE_URL=https://costaricatreeatlas.org/api/admin/images/proposals
