# =============================================================================
# SECURITY WARNING: DO NOT COMMIT ACTUAL VALUES TO GIT
# Copy this file to .env.local and fill in your actual secrets
# =============================================================================

# =============================================================================
# Authentication (REQUIRED for production)
# =============================================================================

# Dev-only: bypass admin authentication (NEVER use in production)
# Set to "true" in .env.local to skip login during development
# ADMIN_DEV_BYPASS=true

# Vercel Postgres connection string
# Get from: https://vercel.com/docs/storage/vercel-postgres/quickstart
DATABASE_URL=

# NextAuth secret for JWT signing (256-bit minimum)
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# NextAuth URL (your site URL)
NEXTAUTH_URL=http://localhost:3000

# MFA encryption key for TOTP secrets (64-character hex string = 32 bytes)
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# TOTP secret salt for admin authentication (32-character hex string = 16 bytes)
# Generate with: openssl rand -hex 16
ADMIN_TOTP_SECRET_SALT=

# =============================================================================
# Rate Limiting (REQUIRED for production)
# =============================================================================

# Upstash Redis for persistent rate limiting
# Sign up for free at https://upstash.com (10,000 commands/day free tier)
# Without these, rate limiting uses in-memory storage (resets on deployment)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Number of trusted proxy hops (optional, default: 2)
# - Behind Cloudflare + Vercel: 2 (default)
# - Behind Cloudflare only: 1
# - Behind custom CDN + Cloudflare + Vercel: 3
# - Direct to Vercel (no CDN): 1
# TRUSTED_PROXY_COUNT=2

# =============================================================================
# Private API v1 Access Control
# =============================================================================

# Shared API key for approved API v1 consumers (server-side only)
API_V1_KEY=

# Optional comma-separated allowlisted IPv4/IPv6 addresses for API v1 access
# Example: API_V1_ALLOWLIST=203.0.113.12,2001:db8::1
API_V1_ALLOWLIST=

# =============================================================================
# Optional Features
# =============================================================================

# IUCN Red List API v4 (optional but strongly recommended)
# Apply for a token at https://api.iucnredlist.org (free, non-commercial use)
# Powers the iucn-verifier subagent and live conservation-status CI checks.
# Without this, the IUCN MCP server is disabled and audits fall back to GBIF's
# cached (potentially stale) IUCN data.
IUCN_TOKEN=

# Pl@ntNet plant identification API (optional)
# Apply for a free key at https://my.plantnet.org → My Apps
# Enables the /api/identify camera-first ID feature (FEATURE_ENABLED auto-activates
# when this key is present — no code change needed).
# Free tier: 500 requests/day. See https://plantnet.org/en/api/ for limits.
PLANTNET_API_KEY=

# Google Cloud APIs (optional — Google Vision was replaced by Pl@ntNet)
# GOOGLE_MAPS_API_KEY=

# CSP Violation Reporting (optional)
# CSP_REPORT_URI=https://your-logging-service.com/csp-report

# =============================================================================
# Public Variables (exposed to browser)
# =============================================================================

# Site URL for canonical links and SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics domain (optional)
# NEXT_PUBLIC_ANALYTICS_DOMAIN=costaricatreeatlas.com
