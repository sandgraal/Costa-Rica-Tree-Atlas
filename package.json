{
  "name": "costa-rica-tree-atlas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "overrides": {
    "hono": "4.12.18",
    "@hono/node-server": "1.19.13",
    "lodash": "4.18.1",
    "@prisma/config": {
      "effect": "3.20.0"
    },
    "postcss": "8.5.16",
    "uuid": "11.1.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate:optional && contentlayer2 build && next build",
    "prisma:generate:optional": "DATABASE_URL=\"${DATABASE_URL:-postgresql://placeholder:placeholder@localhost:5432/placeholder}\" prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md,mdx,css}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md,mdx,css}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:check": "npm run lint && npm run type-check && npm run security:audit",
    "prepare": "husky",
    "contentlayer": "contentlayer2 build",
    "generate:secrets": "node scripts/generate-secrets.mjs",
    "validate:env": "node -e \"require('./src/lib/env/schema.ts')\"",
    "images:audit": "node scripts/manage-tree-images.mjs audit",
    "images:audit:all": "node scripts/manage-tree-images.mjs audit && node scripts/manage-tree-images.mjs audit-gallery",
    "images:audit:gallery": "node scripts/manage-tree-images.mjs audit-gallery",
    "images:validate": "node scripts/validate-image-references.mjs",
    "images:validate:verbose": "node scripts/validate-image-references.mjs --verbose",
    "images:download": "node scripts/manage-tree-images.mjs download",
    "images:download:force": "node scripts/manage-tree-images.mjs download --force",
    "images:refresh": "node scripts/manage-tree-images.mjs refresh",
    "images:refresh:gallery": "node scripts/manage-tree-images.mjs refresh-gallery",
    "images:refresh:gallery:force": "node scripts/manage-tree-images.mjs refresh-gallery --force",
    "images:propose": "node scripts/propose-image-changes.mjs",
    "images:propose:dry": "node scripts/propose-image-changes.mjs --dry-run",
    "images:check": "node scripts/cleanup-tree-images.mjs",
    "images:cleanup": "node scripts/cleanup-tree-images.mjs --write",
    "images:cleanup:force": "node scripts/cleanup-tree-images.mjs --write --force",
    "images:optimize": "node scripts/optimize-images.mjs",
    "images:optimize:force": "node scripts/optimize-images.mjs --force",
    "images:optimize:hero": "node scripts/optimize-hero-image.mjs",
    "images:migrate": "node scripts/migrate-mdx-to-local-images.mjs",
    "images:setup-all": "npm run images:download && npm run images:optimize && npm run images:migrate",
    "content:audit": "node scripts/audit-content-quality.mjs",
    "content:audit:verbose": "node scripts/audit-content-quality.mjs --verbose",
    "content:audit:json": "node scripts/audit-content-quality.mjs --json",
    "content:fact-audit": "node scripts/audit-factual-accuracy.mjs",
    "content:fact-audit:verbose": "node scripts/audit-factual-accuracy.mjs --verbose",
    "content:fact-audit:json": "node scripts/audit-factual-accuracy.mjs --json",
    "content:fact-queue": "node scripts/generate-factual-remediation-queue.mjs",
    "content:fact-queue:top100": "node scripts/generate-factual-remediation-queue.mjs --top=100",
    "content:es-parity-check": "node scripts/check-es-depth-parity.mjs",
    "content:backfill-ids": "node scripts/backfill-canonical-ids.mjs",
    "content:backfill-ids:dry": "node scripts/backfill-canonical-ids.mjs --verbose",
    "content:backfill-ids:write": "node scripts/backfill-canonical-ids.mjs --write --verbose",
    "content:export-dwca": "node scripts/export-dwca.mjs",
    "content:export-dwca:zip": "node scripts/export-dwca.mjs --zip"
  },
  "browserslist": [
    "defaults and supports es6-module"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=-1",
      "prettier --write"
    ],
    "*.{json,md,mdx,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@next/mdx": "^16.2.10",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/postgres": "^0.10.0",
    "argon2": "^0.44.0",
    "botid": "^1.5.11",
    "cloudinary": "^2.10.0",
    "contentlayer2": "^0.5.8",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "fuse.js": "^7.4.2",
    "html2canvas": "^1.4.1",
    "next": "^16.2.6",
    "next-auth": "^4.24.14",
    "next-contentlayer2": "^0.5.8",
    "next-intl": "^4.13.1",
    "next-mdx-remote": "^6.0.0",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@types/google.maps": "^3.65.2",
    "sharp": "^0.35.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
